# Customers who bought more than one car

PREFIX schema: <http://schema.org/>
PREFIX ex:     <http://example.org/vocabulary/>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?customer (COUNT(?car) AS ?carsBought)
WHERE {
    ?car ex:buyer ?c .
    ?c a ex:Customer ;
       rdfs:label ?customer .
}
GROUP BY ?customer
HAVING (COUNT(?car) > 1)
