# Per dealership: number of cars in stock and their average engine power (kW)

PREFIX schema: <http://schema.org/>
PREFIX ex:     <http://example.org/vocabulary/>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?dealership (COUNT(?car) AS ?carsInStock) (AVG(?power) AS ?avgEnginePower)
WHERE {
    ?car ex:dealer ?d ;
         schema:model ?model .
    ?model ex:enginePower ?power .
    ?d schema:name ?dealership .
}
GROUP BY ?dealership
ORDER BY DESC(?carsInStock)
