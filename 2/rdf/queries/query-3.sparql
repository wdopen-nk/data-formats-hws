# All persons with their number of phone numbers

PREFIX schema: <http://schema.org/>
PREFIX ex:     <http://example.org/vocabulary/>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX vcard:  <http://www.w3.org/2006/vcard/ns#>

SELECT ?person ?type (COUNT(?phone) AS ?phones)
WHERE {
    ?p a ?type ;
       rdfs:label ?person .
    ?type rdfs:subClassOf schema:Person .
    OPTIONAL { ?p vcard:hasTelephone ?phone . }
}
GROUP BY ?person ?type
ORDER BY DESC(?phones) ?person
